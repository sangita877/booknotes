
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit Book | BookNotes</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <header class="site-header">
    <a class="logo" href="/">Book<span>Notes.</span></a>

    <nav>
      <a href="/">My Library</a>
      <a class="nav-button" href="/search">+ Add a Book</a>
    </nav>
  </header>

  <main class="container narrow">

    <a href="/" class="back-link">← Back to My Library</a>

    <p class="eyebrow">YOUR READING JOURNAL</p>

    <h1 class="page-title">
      Save what<br>
      <span>you learned.</span>
    </h1>

    <section class="edit-book-heading">

      <% if (book.cover_id) { %>

        <img
          class="result-cover"
          src="https://covers.openlibrary.org/b/id/<%= book.cover_id %>-M.jpg"
          alt="Book cover"
        >

      <% } %>

      <div>
        <h2><%= book.title %></h2>
        <p><%= book.author %></p>
      </div>

    </section>

    <form
      action="/books/<%= book.id %>/edit"
      method="POST"
      class="edit-form"
    >

      <label for="rating">Your Rating</label>

      <select id="rating" name="rating">

        <option value="">Not Rated</option>

        <% for (let number = 5; number >= 1; number--) { %>

          <option
            value="<%= number %>"
            <%= book.rating === number ? "selected" : "" %>
          >
            <%= number %> / 5 Stars
          </option>

        <% } %>

      </select>

      <label for="date_read">
        Date You Finished Reading
      </label>

      <input
        type="date"
        id="date_read"
        name="date_read"
        value="<%= book.date_read ? new Date(book.date_read).toISOString().slice(0, 10) : '' %>"
      >

      <label for="notes">
        Your Notes and Key Ideas
      </label>

      <textarea
        id="notes"
        name="notes"
        rows="9"
        placeholder="What did you learn from this book?"
      ><%= book.notes || "" %></textarea>

      <button type="submit" class="primary-button">
        Save Changes
      </button>

    </form>

  </main>

  <footer>
    Made for readers who want to remember.
  </footer>

</body>
</html>
